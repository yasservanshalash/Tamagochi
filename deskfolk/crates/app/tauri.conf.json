{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Deskfolk",
  "version": "0.1.0",
  "identifier": "com.deskfolk.desktop",
  "build": {
    "frontendDist": "../../ui/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": {
      "cwd": "../../ui",
      "script": "npm run dev"
    },
    "beforeBuildCommand": {
      "cwd": "../../ui",
      "script": "npm run build"
    }
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "resources": {
      "../../characters": "characters"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
