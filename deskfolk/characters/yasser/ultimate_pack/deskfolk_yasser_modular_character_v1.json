  "compatibility_rules": [
    "Every asset must use the same 320x320 authoring canvas and coordinate system.",
    "Every asset must include a pivot and any required connection anchors.",
    "Never scale individual parts at runtime except through a named full-character body preset.",
    "Connected outlines must overlap by 1-2 pixels under the covering layer to prevent seams.",
    "Clothing variants must provide matching torso, upper-arm and forearm pieces.",
    "Head angle determines the compatible beanie, headphones, beard, nose, eyes and mouth set.",
    "Hand pose determines the compatible forearm ending and prop grip anchor.",
    "Use nearest-neighbour rendering and integer coordinates only.",
    "Mirroring is allowed only for explicitly symmetrical assets; asymmetric shading and clothing details need separate left/right sprites."
  ],
  "generation_contract": {
    "required_output": [
      "transparent PNG",
      "one isolated part only",
      "full 320x320 canvas",
      "part placed at exact canonical coordinates",
      "no labels or guides in final PNG"
    ],
    "must_match": [
      "reference character proportions",
      "palette",
      "pixel density",
      "outline thickness",
      "lighting direction",
      "material shading",
      "anchor positions"
    ],
    "prohibited": [
      "redrawing unrelated body parts",
      "changing body scale",
      "changing camera angle",
      "anti-aliasing",
      "subpixel placement",
      "soft edges",
      "new colors outside palette"
    ]
  }
