# Copy this file to `.env` and fill in real values. `.env` is gitignored.
# Never commit real keys.

# Required: your OpenRouter API key (get one at https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-v1-REPLACE_ME

# --- Optional overrides (defaults are set in run_brain.sh) ---
# PET_MODEL=x-ai/grok-4.3
# PET_API_BASE=https://openrouter.ai/api/v1     # or http://localhost:11434/v1 for Ollama
# PIPER_BIN=/path/to/piper/piper
# PIPER_VOICE=/path/to/en_US-ryan-high.onnx

# --- Speech-to-text (whisper) ---
# distil-large-v3 = fast + very accurate on English GPU. Use large-v3 for max
# accuracy. On a CPU-only box, use small/base to keep latency sane.
# PET_STT_MODEL=distil-large-v3
# PET_STT_DEVICE=cuda        # auto-detected; force cuda or cpu if needed
# PET_STT_COMPUTE=float16    # auto (float16 on gpu, int8 on cpu)
